VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=

# Legacy names are also accepted by the browser and invitation function.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Server-only; required only for sending member invitations.
SUPABASE_SERVICE_ROLE_KEY=

# Invitation callback origin. Set to the deployed site's HTTPS URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
